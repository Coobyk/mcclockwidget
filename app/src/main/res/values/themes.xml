<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MCClock" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_stone</item>
        <item name="android:statusBarColor">@color/app_bg_dark</item>
        <item name="android:navigationBarColor">@color/app_bg_dark</item>
        <item name="colorPrimary">@color/mc_panel_fill</item>
        <item name="colorPrimaryDark">@color/mc_panel_dark</item>
        <item name="colorAccent">#7FB238</item>
    </style>

    <!-- Rows in the "about" panel on the app screen. -->
    <style name="RowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/mc_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="RowValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/silkscreen_bold</item>
        <item name="android:textColor">@color/mc_text</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
