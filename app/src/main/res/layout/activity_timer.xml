<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_stone"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/silkscreen_bold"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0"
            android:text="Timer"
            android:textColor="@color/app_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/remainingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/silkscreen_bold"
            android:shadowColor="#CC000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="0"
            android:text="00:00:00"
            android:textColor="@color/app_text"
            android:textSize="48sp" />

        <LinearLayout
            android:id="@+id/inputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/hoursEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="h"
                android:inputType="number"
                android:text="0"
                android:textColor="@color/app_text"
                android:textColorHint="@color/app_text_dim" />

            <EditText
                android:id="@+id/minutesEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="m"
                android:inputType="number"
                android:text="5"
                android:textColor="@color/app_text"
                android:textColorHint="@color/app_text_dim" />

            <EditText
                android:id="@+id/secondsEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:hint="s"
                android:inputType="number"
                android:text="0"
                android:textColor="@color/app_text"
                android:textColorHint="@color/app_text_dim" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/mc_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/silkscreen_bold"
                android:gravity="center"
                android:padding="14dp"
                android:text="Start"
                android:textColor="@color/mc_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pauseButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/mc_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/silkscreen_bold"
                android:gravity="center"
                android:padding="14dp"
                android:text="Pause"
                android:textColor="@color/mc_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/mc_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/silkscreen_bold"
                android:gravity="center"
                android:padding="14dp"
                android:text="Reset"
                android:textColor="@color/mc_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>