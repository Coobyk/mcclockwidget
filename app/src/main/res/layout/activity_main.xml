<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/silkscreen_bold"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0"
            android:text="@string/app_name"
            android:textColor="@color/app_text"
            android:textSize="22sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_tagline"
            android:textColor="@color/app_text_dim"
            android:textSize="13sp" />

        <!-- Hero dial -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/mc_card"
            android:padding="20dp">

            <com.coobyk.mc.clock.ClockView
                android:id="@+id/clockView"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/timeValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/silkscreen_bold"
            android:gravity="center"
            android:shadowColor="#CC000000"
            android:shadowDx="3"
            android:shadowDy="3"
            android:shadowRadius="0"
            android:textColor="@color/app_text"
            android:textSize="40sp"
            tools:text="12:34:56" />

        <!-- Nav -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/alarmsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/mc_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/silkscreen_bold"
                android:gravity="center"
                android:padding="14dp"
                android:text="Alarms"
                android:textColor="@color/mc_green"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timerButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/mc_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/silkscreen_bold"
                android:gravity="center"
                android:padding="14dp"
                android:text="Timer"
                android:textColor="@color/mc_green"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/stopwatchButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/mc_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/silkscreen_bold"
                android:gravity="center"
                android:padding="14dp"
                android:text="Stopwatch"
                android:textColor="@color/mc_green"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Info panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/mc_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView style="@style/RowLabel" android:text="@string/label_local" />

                <TextView
                    android:id="@+id/localValue"
                    style="@style/RowValue"
                    tools:text="12:34" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView style="@style/RowLabel" android:text="@string/label_minecraft" />

                <TextView
                    android:id="@+id/minecraftValue"
                    style="@style/RowValue"
                    tools:text="12:34" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView style="@style/RowLabel" android:text="@string/label_ticks" />

                <TextView
                    android:id="@+id/ticksValue"
                    style="@style/RowValue"
                    tools:text="6521 ticks" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView style="@style/RowLabel" android:text="@string/label_frame" />

                <TextView
                    android:id="@+id/frameValue"
                    style="@style/RowValue"
                    tools:text="22 / 63" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView style="@style/RowLabel" android:text="@string/label_phase" />

                <TextView
                    android:id="@+id/phaseValue"
                    style="@style/RowValue"
                    tools:text="Day" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/addWidgetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/mc_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/silkscreen_bold"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/add_widget"
            android:textColor="@color/app_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/about"
            android:textColor="@color/app_text_dim"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>