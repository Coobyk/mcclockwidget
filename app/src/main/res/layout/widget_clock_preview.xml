<?xml version="1.0" encoding="utf-8"?>
<!-- Shown in the widget picker on Android 12 and newer. Static, so it needs no provider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mc_panel"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_dial_description"
        android:scaleType="fitCenter"
        android:src="@drawable/clock_00" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/silkscreen_bold"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="@color/mc_text_shadow"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="0"
        android:text="@string/widget_time_placeholder"
        android:textColor="@color/mc_text"
        android:textSize="20sp" />

</LinearLayout>
