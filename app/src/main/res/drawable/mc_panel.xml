<?xml version="1.0" encoding="utf-8"?>
<!--
  The classic raised Minecraft GUI panel: a 2dp bevel with a bright top-left edge and a dark
  bottom-right edge around a light grey face.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Whole view starts bright ... -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mc_panel_light" />
        </shape>
    </item>

    <!-- ... everything but a 2dp strip along the top and left turns dark ... -->
    <item
        android:bottom="0dp"
        android:left="2dp"
        android:right="0dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mc_panel_dark" />
        </shape>
    </item>

    <!-- ... and the face is laid on top. -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/mc_panel_fill" />
        </shape>
    </item>

</layer-list>
