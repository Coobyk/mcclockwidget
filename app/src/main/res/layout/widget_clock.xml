<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget is the dial and nothing else: no panel behind it, no digital readout. Leaving both out
  lets the clock item grow to whatever size the widget has been dragged to. The time is still
  announced to screen readers through the content description — see ClockWidgetProvider.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/clock_dial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/clock_00" />

</FrameLayout>
