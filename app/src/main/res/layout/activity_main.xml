<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/silkscreen_bold"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="0"
            android:text="@string/app_name"
            android:textColor="@color/app_text"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_tagline"
            android:textColor="@color/app_text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/mc_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <com.coobyk.mc.clock.ClockView
                android:id="@+id/clockView"
                android:layout_width="match_parent"
                android:layout_height="168dp" />

            <TextView
                android:id="@+id/timeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/silkscreen_bold"
                android:gravity="center"
                android:shadowColor="@color/mc_text_shadow"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="0"
                android:textColor="@color/mc_text"
                android:textSize="28sp"
                tools:text="12:34:56" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/mc_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/label_local" />

                <TextView
                    android:id="@+id/localValue"
                    style="@style/RowValue"
                    tools:text="12:34" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/label_minecraft" />

                <TextView
                    android:id="@+id/minecraftValue"
                    style="@style/RowValue"
                    tools:text="12:34" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/label_ticks" />

                <TextView
                    android:id="@+id/ticksValue"
                    style="@style/RowValue"
                    tools:text="6521 ticks" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/label_frame" />

                <TextView
                    android:id="@+id/frameValue"
                    style="@style/RowValue"
                    tools:text="22 / 63" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/label_phase" />

                <TextView
                    android:id="@+id/phaseValue"
                    style="@style/RowValue"
                    tools:text="Day" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/addWidgetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/mc_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/silkscreen_bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp"
            android:text="@string/add_widget"
            android:textColor="@color/mc_text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/about"
            android:textColor="@color/app_text_dim"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
